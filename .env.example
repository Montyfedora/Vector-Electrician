# ============================================================================
# Vector.SEO — Environment Variables
# ============================================================================
# Copy this file to `.env` for local development. In production, add these in
# Vercel → Project → Settings → Environment Variables (NOT in a committed file).
#
# Legend:  [REQUIRED] app breaks without it   [OPTIONAL] feature degrades gracefully
# ----------------------------------------------------------------------------

# --- Supabase (lead capture) ------------------------------------------------
# [REQUIRED] Your Supabase project URL.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# [REQUIRED] Publishable / anon key. Used by both the browser and the server
# function that saves leads (the RLS policy allows anonymous inserts).
SUPABASE_PUBLISHABLE_KEY="eyJ...anon-key..."

# [REQUIRED] Same two values, exposed to the client bundle at build time.
# These must be present at BUILD time on Vercel (any environment that builds).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ...anon-key..."

# [OPTIONAL for the funnel, REQUIRED for the /admin/leads dashboard]
# Service-role key. Lead capture does NOT need it (uses anon + RLS), but the
# admin dashboard reads ALL leads, which requires bypassing RLS.
# WARNING: never expose this to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service-role-key..."

# [REQUIRED for /admin/leads] Access code for the leads dashboard. Pick a long
# random string; you'll type it once to view leads at /admin/leads.
ADMIN_TOKEN="choose-a-long-random-secret"

# --- Claude (free article generator) ----------------------------------------
# [REQUIRED for the article feature] Anthropic API key. Without it, the funnel
# still captures the lead but shows a "we'll follow up" message instead of an
# article.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Resend (email delivery) ------------------------------------------------
# [OPTIONAL but recommended] Sends the generated article to the lead + a copy to
# you. Without it, the funnel works but won't email anything (copy auto-adjusts).
RESEND_API_KEY="re_..."

# Verified sender. Until you verify your own domain in Resend, you can use the
# shared sandbox sender below (deliverability is limited).
LEAD_FROM_EMAIL="Vector.SEO <onboarding@resend.dev>"

# [OPTIONAL] Inbox that receives a full copy of every new lead (details + the
# generated article), with reply-to set to the lead. Defaults to
# monty@acadium.com if unset.
LEAD_NOTIFY_EMAIL="monty@acadium.com"

# --- SerpApi + Perplexity (live visibility scan on /electricians) -----------
# [OPTIONAL] Only used by the deeper "analyzeVisibility" scan on the older
# /electricians route. The /electricians-2 funnel does NOT need these.
SERPAPI_KEY=""
PERPLEXITY_API_KEY=""

# --- Build target -----------------------------------------------------------
# [OPTIONAL] Defaults to "vercel". Set to "cloudflare-module" or "node-server"
# to build for a different host. vercel.json already pins this to "vercel".
# NITRO_PRESET="vercel"
